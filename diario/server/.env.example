# Senha usada para entrar no diário (defina uma senha forte, só você vai saber)
DIARY_PASSWORD=

# Chave secreta para assinar a sessão de login (gere uma string aleatória longa)
JWT_SECRET=

# Porta em que o servidor vai rodar (a maioria dos serviços de hospedagem define sozinha)
PORT=3000

# --- Backup automático por e-mail ---
# Servidor SMTP usado para enviar o backup (o padrão já serve para Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
# Conta que envia o e-mail de backup
EMAIL_USER=
# Senha de app do Gmail (não é a senha normal da conta — veja o README)
EMAIL_PASS=
# Para onde o backup é enviado (deixe em branco para enviar para o próprio EMAIL_USER)
EMAIL_TO=
# Intervalo mínimo, em minutos, entre e-mails de backup enquanto você digita sem parar
# (toda vez que você sai da entrada, troca de dia ou fecha o app, o backup é enviado na hora)
EMAIL_BACKUP_MIN_INTERVAL_MINUTES=5
