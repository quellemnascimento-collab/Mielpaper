# Senha usada para entrar no diário (defina uma senha forte, só você vai saber)
DIARY_PASSWORD=

# Chave secreta para assinar a sessão de login (gere uma string aleatória longa)
JWT_SECRET=

# Porta em que o servidor vai rodar (a maioria dos serviços de hospedagem define sozinha)
PORT=3000

# --- Backup automático no GitHub ---
# Token de acesso pessoal do GitHub com permissão de escrita (repo -> contents)
GITHUB_TOKEN=
# Dono do repositório, ex: quellemnascimento-collab
GITHUB_OWNER=quellemnascimento-collab
# Nome do repositório, ex: mielpaper
GITHUB_REPO=mielpaper
# Branch onde os backups serão salvos
GITHUB_BRANCH=main
# Pasta dentro do repositório onde cada dia vira um arquivo .md
GITHUB_BACKUP_PATH=diario/backups
